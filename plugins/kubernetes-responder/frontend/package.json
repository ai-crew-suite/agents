{
  "name": "@ai-crew-suite/plugin-agent-kubernetes-responder",
  "description": "Frontend user interface for the Kubernetes AI responder: trigger a read-only incident investigation, follow it live over SSE, and inspect the cited evidence and triage report.",
  "version": "0.0.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "keywords": [
    "agentic workflow",
    "ai-crew-suite",
    "frontend-plugin",
    "backstage",
    "kubernetes-responder"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "kubernetes-responder"
  },
  "bugs": {
    "url": "https://github.com/ai-crew-suite/agents/issues",
    "email": "support@ai-crew-suite.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-crew-suite/agents",
    "directory": "plugins/agents/kubernetes-responder/frontend"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "crew build",
    "clean": "crew clean",
    "lint": "crew lint",
    "test:e2e": "crew test:e2e",
    "test:unit": "crew test:unit",
    "test:unit:coverage": "crew test:unit:coverage",
    "typecheck": "crew typecheck"
  },
  "dependencies": {
    "@ai-crew-suite/plugin-kernel-node": "workspace:^",
    "@ai-crew-suite/plugin-kernel": "workspace:^",
    "@backstage/catalog-model": "backstage:^",
    "@backstage/core-components": "backstage:^",
    "@backstage/core-plugin-api": "backstage:^",
    "@backstage/frontend-plugin-api": "backstage:^",
    "@backstage/plugin-catalog": "backstage:^",
    "@material-ui/core": "catalog:prod",
    "eventsource-parser": "catalog:prod",
    "react": "catalog:prod",
    "react-dom": "catalog:prod",
    "react-router-dom": "catalog:prod"
  },
  "peerDependencies": {
    "react": "catalog:prod",
    "react-router-dom": "catalog:prod"
  },
  "devDependencies": {
    "@ai-crew-suite/cli": "workspace:*",
    "@backstage/dev-utils": "backstage:^",
    "@backstage/test-utils": "backstage:^",
    "@testing-library/jest-dom": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@testing-library/user-event": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "storybook": "catalog:dev",
    "vitest": "catalog:dev"
  }
